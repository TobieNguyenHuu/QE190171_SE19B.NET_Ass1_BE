# Copy these into Render -> your Web Service -> Environment (never commit real values).

# PostgreSQL connection. Render gives you a URL like:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

ASPNETCORE_ENVIRONMENT=Production

# Frontend origin(s) allowed by CORS - your Vercel URL, comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: keep Swagger available in Production (default true in appsettings.json).
# Swagger__Enabled=true
